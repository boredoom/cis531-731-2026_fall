{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kddresearch.org/cis531-731/schemas/vector_record.schema.json",
  "title": "ProvenanceBearingVectorRecord",
  "description": "Standardized schema for vector database records encoding regional hip-hop lyric chunks, embeddings, and full upstream lineage provenance.",
  "type": "object",
  "required": [
    "record_id",
    "document_id",
    "chunk_id",
    "chunk_metadata",
    "text_payload",
    "dense_embedding",
    "similarity_config",
    "provenance",
    "ontology_assertions"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique canonical identifier for the vector index entry."
    },
    "document_id": {
      "type": "string",
      "pattern": "^genius-[0-9]+$",
      "description": "Foreign key referencing the parent Silver song record."
    },
    "chunk_id": {
      "type": "string",
      "pattern": "^genius-[0-9]+#c[0-9]{3}$",
      "description": "Deterministic chunk identifier conforming to {doc_id}#c{chunk_index}."
    },
    "chunk_metadata": {
      "type": "object",
      "required": [
        "chunk_index",
        "total_chunks",
        "char_start",
        "char_end",
        "token_count",
        "structural_section"
      ],
      "properties": {
        "chunk_index": { "type": "integer", "minimum": 0 },
        "total_chunks": { "type": "integer", "minimum": 1 },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 1 },
        "token_count": { "type": "integer", "minimum": 1, "maximum": 512 },
        "structural_section": {
          "type": "string",
          "enum": ["intro", "verse", "chorus", "hook", "bridge", "outro", "freestyle"]
        }
      },
      "additionalProperties": false
    },
    "text_payload": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4096,
      "description": "Raw, normalized text segment ingested for embedding."
    },
    "dense_embedding": {
      "type": "array",
      "description": "768-dimensional dense representation generated by the registered bi-encoder.",
      "minItems": 768,
      "maxItems": 768,
      "items": {
        "type": "number"
      }
    },
    "similarity_config": {
      "type": "object",
      "required": ["metric", "dimension", "is_normalized"],
      "properties": {
        "metric": { "type": "string", "enum": ["inner_product", "cosine", "l2"] },
        "dimension": { "type": "integer", "const": 768 },
        "is_normalized": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_uri",
        "retrieval_timestamp",
        "license_class",
        "ingest_pipeline_version",
        "git_commit_sha",
        "content_sha256"
      ],
      "properties": {
        "source_uri": { "type": "string", "format": "uri" },
        "retrieval_timestamp": { "type": "string", "format": "date-time" },
        "license_class": {
          "type": "string",
          "enum": ["academic_research", "fair_use_evaluation", "creative_commons", "public_domain"]
        },
        "ingest_pipeline_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "git_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "ontology_assertions": {
      "type": "object",
      "required": ["primary_trope", "regional_dialect", "temporal_era", "confidence"],
      "properties": {
        "primary_trope": { "type": "string" },
        "regional_dialect": {
          "type": "string",
          "enum": ["East Coast", "West Coast", "Southern", "Midwest", "Universal"]
        },
        "temporal_era": {
          "type": "string",
          "enum": ["Golden Era", "Bling Era", "Streaming Era"]
        },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
